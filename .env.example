# O padrão do código é simulação. Estas variáveis habilitam a bancada.
BENCH_MODE=1
ARM_OUTPUT=YES

AMETEK_PORT=COM10
AMETEK_BAUDRATE=115200
AMETEK_TIMEOUT_S=5
AMETEK_QUERY_EOT=1
AMETEK_EXPECTED_MODEL=MX30
AMETEK_CLEAR_USER_WAVEFORMS=0

KEYSIGHT_RESOURCE=USB0::0x0957::0x17A4::MY59240844::0::INSTR
KEYSIGHT_EXPECTED_MODEL=DSOX4034A
KEYSIGHT_TIMEOUT_MS=15000

# Valores conservadores de comissionamento; confirme com o EUT.
BASE_VOLTAGE_RMS=5
SOURCE_VOLTAGE_RANGE_RMS=150
EUT_MAX_VOLTAGE_RMS=10
EUT_MAX_PEAK_V=100
CURRENT_LIMIT_A=0.5
CURRENT_PROTECTION_DELAY_S=0.1

# Obrigatório em BENCH_MODE: copie o fator exato da probe instalada.
VOLTAGE_PROBE_ATTENUATION=
EXT_TRIGGER_PROBE_ATTENUATION=1
EXT_TRIGGER_RANGE_V=8
EXT_TRIGGER_LEVEL_V=1.5

CAPTURE_CURRENT=0
CURRENT_PROBE_ATTENUATION=
CURRENT_BASE_A=

# Comissionamento físico começa com uma captura por classe.
REAL_CAPTURES_PER_CLASS=1
# Dataset sintético completo.
SIM_CAPTURES_PER_CLASS=2000
SNR_LEVELS_DB=30
# Para gerar também os níveis opcionais: SNR_LEVELS_DB=20,30,40,50
