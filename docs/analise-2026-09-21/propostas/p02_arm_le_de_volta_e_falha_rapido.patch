+    def _pista_de_init_ignorado(self, ultimo_estado: str) -> str:
+        """Mensagem de diagnóstico para o INIT que não teve efeito.
+
+        Manual p. 129: "If the trigger system is not in the Idle state, the
+        initiate commands are ignored"; Apêndice C, p. 214: ``-220 "Init
+        ignored"``. A assinatura observada na bancada (relatório 01 §1.3 B5,
+        classe 05) é exatamente esta: nenhum erro no INIT e o estado preso em
+        IDLE. Lê a fila de forma TOLERANTE (a fonte pode já estar muda) só
+        para enriquecer a mensagem — nunca troca a exceção original."""
+        try:
+            erros = self.check_errors()
+        except Exception:  # noqa: BLE001 - diagnóstico best-effort
+            return "Não foi possível ler SYSTem:ERRor? para diagnosticar."
+        if any(codigo == -220 for codigo, _ in erros):
+            return (
+                f"Fila SCPI contém -220 'Init ignored' ({erros}): o INITiate foi "
+                "descartado porque o sistema de trigger não estava Idle (manual "
+                "p. 129). Suspeite do falso IDLE documentado na p. 132."
+            )
+        if erros:
+            return f"Fila SCPI após o INIT: {erros}."
+        if ultimo_estado.startswith("IDLE"):
+            return (
+                "Fila SCPI limpa e estado preso em IDLE — assinatura de INITiate "
+                "ignorado em silêncio (manual p. 129)."
+            )
+        return "Fila SCPI limpa."
+
+    def _conferir_transiente_programado(self) -> None:
+        """Lê de volta o transiente nativo recém-programado e recusa divergência.
+
+        Simetria com ``arm_transient()``, que já lê 9 parâmetros do caminho
+        LIST e é justamente o caminho que funcionou nas duas sessões de
+        2026-09-16 (relatório 01 §1.2). Consulta só cabeçalhos que a Rev. 5.53
+        implementa como QUERY: ``VOLTage:MODE?``, ``VOLTage:TRIGgered?``,
+        ``PULSe:WIDTh?``, ``FUNCtion:MODE?`` e ``SOURce:FREQuency:MODE?``.
+        ``FUNCtion:SHAPe?`` e ``SOURce:MODE?`` ficam de fora de propósito: a
+        Rev. 5.53 aceita os dois como COMANDO e não como QUERY, devolvendo
+        ``-113`` (ver docstring de ``aguardar_resposta``)."""
+        if not self._transiente_esperado:
+            return
+        lidos: Dict[str, str] = {}
+        divergencias: Dict[str, str] = {}
+        for consulta, esperado in self._transiente_esperado.items():
+            resposta = self.query(consulta).strip()
+            lidos[consulta] = resposta
+            if isinstance(esperado, str):
+                # A Rev. 5.53 responde na forma curta ("FIX", "PULS"): aceita
+                # qualquer prefixo comum de 3+ letras nos dois sentidos.
+                obtido = resposta.upper().strip('"')
+                alvo = esperado.upper()
+                if not (obtido.startswith(alvo) or alvo.startswith(obtido)) or not obtido:
+                    divergencias[consulta] = f"esperado {esperado!r}, lido {resposta!r}"
+                continue
+            try:
+                valor = float(resposta)
+            except (TypeError, ValueError):
+                divergencias[consulta] = f"esperado {esperado!r}, resposta não numérica {resposta!r}"
+                continue
+            alvo = float(esperado)
+            if abs(valor - alvo) > max(1e-6, abs(alvo) * self.TOLERANCIA_READBACK):
+                divergencias[consulta] = f"esperado {alvo:.6g}, lido {valor:.6g}"
+        if divergencias:
+            raise InstrumentHardwareError(
+                "A AMETEK NÃO aplicou o transiente nativo programado "
+                f"({divergencias}); leitura completa={lidos}. Captura recusada em vez "
+                "de gravar dado rotulado errado (H-NATIVO, relatório 01 §1.2)."
+            )
 
