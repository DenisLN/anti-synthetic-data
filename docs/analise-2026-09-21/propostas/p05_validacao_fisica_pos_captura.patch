--- a/logica/sinais.py
+++ b/logica/sinais.py
@@ -119,3 +119,153 @@ def snr_medida(limpo: np.ndarray, ruidoso: np.ndarray) -> float:
     potencia_sinal = float(np.mean(np.square(limpo)))
     potencia_ruido = float(np.mean(np.square(ruidoso - limpo)))
