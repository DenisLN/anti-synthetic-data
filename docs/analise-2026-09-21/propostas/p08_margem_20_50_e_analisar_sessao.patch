index d966aeb..6dd7e14 100644
--- a/logica/sinais.py
+++ b/logica/sinais.py
@@ -269,3 +269,23 @@ def comparar_fisicamente(
         "thd_medida": thd_obtida,
         "thd_esperada": thd_esperada,
     }
+
